{
  "case_id": "pj-04-zhahong",
  "category": "诈哄骗",
  "title": "官票采买·绸铺",
  "source": "《骗经·诈哄骗》改写",
  "you": "县城绸缎铺东家，与衙门无深交，最怕得罪官面上人",
  "counterparty": "自称府里采买差的瘦高男子，身后跟着两个随从",
  "scenes": [
    {"id": 1, "name": "设饵", "text": "来人出示一张朱印票文，说是府里办庆典，要采三十匹缎。\n「价照官价，款项月内批下来，先挂个账。」", "probes": [
      {"id": "s1a", "label": "细看票文上的印与字", "cost": 0.2, "rel": 0.8},
      {"id": "s1b", "label": "托熟识的书办问一句", "cost": 0.6, "rel": 0.7}
    ]},
    {"id": 2, "name": "示信", "text": "他当场掏出一成定银，还多给了一钱「跑腿费」。\n又说：「你若不信，可去府前西角问，问采买差张爷便是。」", "probes": [
      {"id": "s2a", "label": "派人去府前西角核这人", "cost": 0.5, "rel": 0.8},
      {"id": "s2b", "label": "要他把定银换成官银票", "cost": 0.2, "rel": 0.6}
    ]},
    {"id": 3, "name": "小试", "text": "头一小批五匹取走，三日后他竟送来一张准许补款的批条，还夸你货好。\n批条上有印，看不出破。", "probes": [
      {"id": "s3a", "label": "拿批条去银号问能否兑", "cost": 0.4, "rel": 0.85}
    ]},
    {"id": 4, "name": "加注", "text": "剩余二十五匹要一次取走，且暗示经手人要「打点」。\n「你不打点，款子压到年底。」", "probes": [
      {"id": "s4a", "label": "去衙门当面问有无此人", "cost": 0.8, "rel": 0.9},
      {"id": "s4b", "label": "要求见批款的师爷", "cost": 0.3, "rel": 0.7}
    ]},
    {"id": 5, "name": "收网", "text": "货已装车，打点银子装在你袖里。\n车马一动，这单就成定局。", "probes": [
      {"id": "s5a", "label": "最后一刻扣下车马", "cost": 0.4, "rel": 0.9}
    ]}
  ],
  "types": {
    "honest": {"note": "真是府里采买，只是款子走得慢"},
