{
  "case_id": "pj-02-diubao",
  "category": "丢包骗",
  "title": "拾包分银·旅店",
  "source": "《骗经·丢包骗》改写",
  "you": "候船北上的小商人，身上带了六十两本钱",
  "counterparty": "同店隔壁房客，自称也是等船的生意人",
  "scenes": [
    {"id": 1, "name": "设饵", "text": "隔壁客兴冲冲进来，说在茅房捡到一只银包，约有百两。\n他压低声音：「见者有份，但你得先出五两做个封口押，免得你反悔去报官。」", "probes": [
      {"id": "s1a", "label": "先看看那银包里头是什么", "cost": 0.0, "rel": 0.85},
      {"id": "s1b", "label": "问他为何不自己留下", "cost": 0.0, "rel": 0.55}
    ]},
    {"id": 2, "name": "示信", "text": "他把银包往你手里一塞，沉甸甸的，封皮还带着泥。\n「你先拿着，我去外头望风，若有人找就散。」", "probes": [
      {"id": "s2a", "label": "拆封验里面是什么", "cost": 0.2, "rel": 0.8},
      {"id": "s2b", "label": "说要等失主来认，不私分", "cost": 0.0, "rel": 0.6}
    ]},
    {"id": 3, "name": "小试", "text": "他回来时很高兴，真递给你一小锭碎银：「先分你一点，剩下的等风声过了再分。」", "probes": [
      {"id": "s3a", "label": "验这锭碎银成色", "cost": 0.2, "rel": 0.85}
    ]},
    {"id": 4, "name": "加注", "text": "他说失主已经报官，包不能放你这，得由他连夜带走。\n「你那五两押金我先还你二两，其余到了地头一并算。」", "probes": [
      {"id": "s4a", "label": "要求把整包当面过秤封存", "cost": 0.3, "rel": 0.85},
      {"id": "s4b", "label": "去问店主这人的来路", "cost": 0.4, "rel": 0.6}
    ]},
    {"id": 5, "name": "收网", "text": "天没亮，他已经把行李搬到门口，说船到了。\n你手里的银包还没拆过第二回。", "probes": [
      {"id": "s5a", "label": "当着他的面拆包", "cost": 0.3, "rel": 0.9}
    ]}
  ],
  "types": {
    "honest": {"note": "真捡到包，只想找人平分"},
